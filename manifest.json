{
    "name": "♩♪ Remember Me ♫♩",
    "version": "1.0.2",
    "description": "Appropriately notifies you when a web page offers to remember you",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "offscreen"
    ],
    "icons": {
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
